# =============================================================================
#  .gitignore
#  Project: Reinforcement Learning as Optimization (0/1 knapsack comparison)
# =============================================================================
#  写法约定（Git 官方规则）：
#    * 路径分隔符一律用正斜杠 /，Windows 下同样生效（不要写反斜杠 \ ）
#    * 前导 /     仅匹配仓库根目录；不以 / 开头则匹配任意层级
#    * 尾随 /     仅匹配目录
#    * 前导 !     取消忽略，必须写在对应忽略规则之后；若父目录已被排除，! 无效
#    * 支持 * ? [] 通配；** 跨层级匹配；行尾空格需写成 "\ "
#    * # 开头为注释；模式内部的 # 需转义为 \#
#    * 本文件按「项目生成物 → 语言/工具 → 环境 → 系统/编辑器」分节
# =============================================================================


# =============================================================================
#  1. 本项目生成物（体积大或可由脚本重新生成，不进版本库）
# =============================================================================
# 原始数据（UCI Online Retail 工作簿）、生成语料、清洗中间结果
/datasets/
# 冻结语料实例：instances/{train,validation,test}.jsonl，数百万行量级
/instances/
# 指标、图表、参照解、训练日志
/results/
/logs/
# 训练产出的模型权重
/checkpoints/


# =============================================================================
#  2. Python 虚拟环境
# =============================================================================
# 任意层级下的虚拟环境目录
venv/
.venv/
virtualenv/
# 以下名称过于通用，只在仓库根目录生效，避免误伤源码目录
/env/
/ENV/
/venv.bak/
/.venv.bak/


# =============================================================================
#  3. Python 编译产物与打包中间件
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
# setuptools / wheel 打包产物（均为根目录下的遗留目录）
/build/
/dist/
/sdist/
/wheels/
/develop-eggs/
/downloads/
/eggs/
/.eggs/
*.egg-info/
*.egg
.installed.cfg
# C 扩展编译产物
*.so


# =============================================================================
#  4. 测试 / 类型检查 / Lint / 覆盖率 缓存
# =============================================================================
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/
.pylint.d/
.hypothesis/
.tox/
.nox/
.cache/
.coverage
.coverage.*
*.py,cover
coverage.xml
htmlcov/
nosetests.xml
pytestdebug.log


# =============================================================================
#  5. Jupyter Notebook
# =============================================================================
.ipynb_checkpoints/
.virtual_documents/
# 仓库内生成的 Jupyter / IPython 运行时配置
/.jupyter/
/.ipython/


# =============================================================================
#  6. Python 项目工具产生的点文件
# =============================================================================
# 以下几个 Spyder/Rope 产物在不同版本下可能是文件也可能是目录，故不加尾随 /
.spyderproject
.spyderworkspace
.spyproject
.ropeproject
# 本地解释器版本标记（若需随仓库共享，另加一行 "!.python-version"）
.python-version


# =============================================================================
#  7. 环境变量与密钥
# =============================================================================
# 注意顺序：先排除 .env.*，再用 ! 放行示例文件
.env
.env.*
!.env.example
!.env.template


# =============================================================================
#  8. 日志、临时文件与锁文件
# =============================================================================
*.log
*.pid
*.tmp
*.temp
*.bak
*.orig
*.rej
# 编辑器交换文件与备份
*.swp
*.swo
*.swn
*~
# LibreOffice / OpenOffice 锁文件
.~lock.*#
# Microsoft Office 自动恢复与锁文件（~$报告.docx、~$slides.pptx）
~$*
# 浏览器未完成的下载
*.crdownload
*.part
*.partial
# 崩溃转储
*.stackdump
core
core.*


# =============================================================================
#  9. 操作系统元数据
# =============================================================================
# macOS
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems
.VolumeIcon.icns
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
# Linux
.directory
.Trash-*
.fuse_hidden*


# =============================================================================
#  10. 编辑器 / IDE（各类以 . 开头的配置目录）
# =============================================================================
# JetBrains (PyCharm)
.idea/
# VS Code
.vscode/
.history/
*.code-workspace
# Visual Studio
.vs/
# Emacs 自动保存与锁文件（*.swp / *~ 见第 8 节）
.#*
\#*\#
# 通用编辑器备份
*.save
*.autosave


# =============================================================================
#  11. AI 辅助工具本地配置
# =============================================================================
# 仅忽略个人本地设置；如需共享请提交 .claude/settings.json
.claude/settings.local.json
.claude/*.local.*
